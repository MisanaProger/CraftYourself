{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MisanaProger/CraftYourself/docs/schemas/roadmap-schema.json",
  "title": "Craft Yourself roadmap data",
  "description": "Schema of roadmap/*.toml (as parsed into JSON) and of `est-roadmap export`. Semantic rules (R01–R14) are in docs/roadmap-management.md; crates/est-roadmap/tests/repository.rs keeps the enums and field names of this file in sync with the code.",
  "type": "object",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{2,5}-[0-9]{3,}$",
      "description": "Stable id: the prefix of the roadmap where the item was created and a number. Never reused, kept when the item moves."
    },
    "ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "path": { "type": "string", "pattern": "^[^/].*$", "description": "Repository path relative to the root, optionally with #anchor." },
    "checklist": {
      "type": "array",
      "items": { "type": "string", "pattern": "^\\[( |x)\\] .+" }
    },
    "kind": { "enum": ["program", "epic", "feature", "task", "subtask", "release"] },
    "status": {
      "enum": ["proposed", "planned", "ready", "in-progress", "in-review", "blocked", "done", "deferred", "cancelled"]
    },
    "priority": { "enum": ["P0", "P1", "P2", "P3"] },
    "risk": { "enum": ["low", "medium", "high"] },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "summary", "reason"],
      "properties": {
        "date": { "$ref": "#/$defs/date" },
        "summary": { "type": "string" },
        "reason": { "type": "string" },
        "impact": { "type": ["string", "null"] },
        "decision": { "type": ["string", "null"], "description": "Path of an ADR or another document." }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/kind" },
        "status": { "$ref": "#/$defs/status" },
        "priority": { "anyOf": [{ "$ref": "#/$defs/priority" }, { "type": "null" }], "description": "Required except for releases." },
        "description": { "type": ["string", "null"], "description": "Required for programs, epics, features and releases." },
        "owner": { "type": ["string", "null"], "description": "Defaults to default_owner." },
        "parent": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }], "description": "Required except for programs and releases; must be higher in Program → Epic → Feature → Task → Subtask." },
        "depends_on": { "$ref": "#/$defs/ids" },
        "blocks": { "$ref": "#/$defs/ids" },
        "related_to": { "$ref": "#/$defs/ids" },
        "implements": { "$ref": "#/$defs/ids" },
        "validates": { "$ref": "#/$defs/ids" },
        "extends": { "$ref": "#/$defs/ids" },
        "replaces": { "$ref": "#/$defs/ids" },
        "acceptance": { "$ref": "#/$defs/checklist", "description": "Acceptance criteria; required for features, tasks and subtasks from Ready on (outside research roadmaps)." },
        "done_when": { "$ref": "#/$defs/checklist", "description": "Item-specific Definition of Done, in addition to the project's." },
        "hypothesis": { "type": ["string", "null"] },
        "accept_if": { "type": ["string", "null"] },
        "reject_if": { "type": ["string", "null"] },
        "result": { "type": ["string", "null"] },
        "estimate_days": { "type": ["number", "null"], "minimum": 0 },
        "actual_days": { "type": ["number", "null"], "minimum": 0 },
        "risk": { "anyOf": [{ "$ref": "#/$defs/risk" }, { "type": "null" }] },
        "release": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }], "description": "Target release (an item of kind release)." },
        "due": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "version": { "type": ["string", "null"], "description": "Releases: version number." },
        "components": { "type": "array", "items": { "$ref": "#/$defs/path" } },
        "docs": { "type": "array", "items": { "$ref": "#/$defs/path" } },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "`debt` marks technical debt." },
        "source": { "type": ["string", "null"] },
        "status_reason": { "type": ["string", "null"], "description": "Required for blocked (unless a dependency is open), deferred and cancelled." },
        "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } },
        "roadmap": { "type": "string", "description": "Export only: id of the roadmap whose file holds the item." }
      }
    },
    "roadmap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "prefix", "file", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "title": { "type": "string" },
        "prefix": { "type": "string", "pattern": "^[A-Z]{2,5}$" },
        "file": { "type": "string" },
        "description": { "type": "string" },
        "hypothesis_driven": { "type": "boolean", "default": false }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "views_dir", "summary_file", "roadmap"],
      "properties": {
        "version": { "const": 1 },
        "default_owner": { "type": ["string", "null"] },
        "definition_of_done": { "type": "array", "items": { "type": "string" } },
        "views_dir": { "type": "string" },
        "summary_file": { "type": "string" },
        "roadmap": { "type": "array", "items": { "$ref": "#/$defs/roadmap" } }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "item": { "type": "array", "items": { "$ref": "#/$defs/item" } } }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/config" },
    { "$ref": "#/$defs/file" },
    {
      "description": "est-roadmap export",
      "type": "object",
      "required": ["format", "config", "items", "findings"],
      "properties": {
        "format": { "const": "craft-yourself-roadmap/1" },
        "config": { "type": "object" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
        "findings": { "type": "array" }
      }
    }
  ]
}
